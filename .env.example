# GitHub API Token (Recommended: increases rate limits from 60 to 5,000 requests/hr)
# Generate at https://github.com/settings/tokens (Scope: public_repo)
GITHUB_TOKEN=ghp_your_github_token_here

# AI / LLM Configuration (Optional: provides Claude or OpenAI powered architectural analysis)
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
DEFAULT_AI_PROVIDER=auto
AI_MODEL=claude-3-5-sonnet-20241022

# Email / SMTP Configuration (Optional: only needed if using --email flag for automated dispatch)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_USE_TLS=true

# Search & Analysis Defaults
MAX_REPOSITORIES=15
MIN_STARS=100
REQUEST_TIMEOUT_SECONDS=30
